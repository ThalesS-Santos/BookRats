# IMPORTANTE: este arquivo documenta QUAIS secrets existem, não os valores reais.
# Os valores reais NUNCA vão em .env commitado. Em produção/deploy, use exclusivamente:
#   firebase functions:secrets:set NOME_DO_SECRET
# (Google Secret Manager — ver docs/monetizacao/0_ROADMAP_IMPLEMENTACAO.md, Etapa 4)
#
# Para rodar o Firebase Emulator localmente, crie um `.env.local` (git-ignorado) com
# valores de sandbox/teste — nunca chaves de produção.

# RevenueCat — secret do header Authorization enviado nos webhooks
REVENUECAT_WEBHOOK_SECRET=VALUE_PLACEHOLDER

# Stripe (se usado diretamente, além do RevenueCat)
STRIPE_WEBHOOK_SECRET=VALUE_PLACEHOLDER

# Google AdMob SSV — URL de onde buscar as chaves públicas de verificação (não é secret,
# mas fica documentado aqui por fazer parte do mesmo fluxo de validação de webhook)
ADMOB_SSV_PUBLIC_KEYS_URL=VALUE_PLACEHOLDER

# APIs de afiliados (ex: Amazon Product Advertising API)
AFFILIATE_AMAZON_ACCESS_KEY=VALUE_PLACEHOLDER
AFFILIATE_AMAZON_SECRET_KEY=VALUE_PLACEHOLDER
AFFILIATE_AMAZON_PARTNER_TAG=VALUE_PLACEHOLDER
